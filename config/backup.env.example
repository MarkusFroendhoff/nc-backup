# Kopie nach /etc/nc-backup/backup.env (empfohlen) oder config/backup.env
# chmod 600 backup.env

# --- Nextcloud ---
NC_INSTALL_DIR="/var/www/nextcloud"
NC_DATA_DIR="/var/www/nextcloud/data"
NC_CONFIG="${NC_INSTALL_DIR}/config/config.php"
NC_OCC_USER="www-data"

# Wartungsmodus während des Backups (empfohlen: true)
NC_MAINTENANCE_MODE="true"

# --- Datenbank: mariadb | postgresql ---
DB_TYPE="mariadb"

# MariaDB/MySQL (aus config.php oder manuell)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="nextcloud"
DB_USER="nextcloud"
# Leer lassen, wenn ~/.my.cnf oder /etc/mysql/debian.cnf genutzt wird
DB_PASSWORD=""

# PostgreSQL (nur wenn DB_TYPE=postgresql)
PG_HOST="localhost"
PG_PORT="5432"
PG_DATABASE="nextcloud"
PG_USER="nextcloud"
# Optional: ~/.pgpass statt PG_PASSWORD
PG_PASSWORD=""

# --- Ziel ---
BACKUP_ROOT="/var/backups/nextcloud"
RETENTION_DAYS="14"

# Kompression: gzip | zstd (zstd benötigt zstd auf dem System)
COMPRESS="gzip"

# Optional: rsync-Ziel (leer = deaktiviert)
# RSYNC_TARGET="user@backup-server:/backups/nextcloud/"

# Optional: Benachrichtigung bei Fehler
# NOTIFY_EMAIL="admin@example.com"
