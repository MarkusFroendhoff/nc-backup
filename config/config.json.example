{
  "install_mode": "native",
  "source_folders": [
    "/var/www/nextcloud/data",
    "/var/www/nextcloud/config"
  ],
  "export_path": "/mnt/backup",
  "config_php_path": "/var/www/nextcloud/config/config.php",
  "docker_nextcloud_container": "",
  "docker_db_container": "",
  "include_database": true,
  "encrypt_backups": false,
  "gpg_mode": "symmetric",
  "gpg_recipient": "",
  "remove_plaintext_after_encrypt": true,
  "password_hash": null,
  "schedule": {
    "enabled": false,
    "hour": 2,
    "minute": 0,
    "weekdays": [0, 1, 2, 3, 4, 5, 6]
  },
  "setup_complete": false
}
